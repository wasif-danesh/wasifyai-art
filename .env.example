# Copy to .env. Development defaults only: never reuse these anywhere shared.
DATABASE_URL=postgresql+asyncpg://wsh:wsh@localhost:5433/wsh
REDIS_URL=redis://localhost:6380/0
AUTH_MODE=stub

# stub = placeholder images, no GPU. real = drive ComfyUI at COMFYUI_BASE_URL.
COMFYUI_MODE=stub
GPU_ID=gpu0
# local = ./data folder; s3 = the S3 API below (SeaweedFS)
STORAGE_BACKEND=local

# Providers (config/providers.yaml): a provider is "configured" when its address is set.
# Native ComfyUI on the Mac; from a container use http://host.containers.internal:8188
COMFYUI_BASE_URL=

# The ComfyUI `models` folder the hub scans (read-only; only .safetensors files are read).
MODELS_DIR=

# Object storage (SeaweedFS, S3 API). Not used by the API yet.
STORAGE_ENDPOINT=http://localhost:8334
STORAGE_BUCKET=wasifyai-art
STORAGE_ACCESS_KEY=wsh-dev
STORAGE_SECRET_KEY=wsh-dev-secret

# Web (server side only)
API_BASE_URL=http://localhost:8010
